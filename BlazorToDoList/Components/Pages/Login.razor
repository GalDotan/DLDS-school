@page "/login"
@rendermode InteractiveServer
@using BlazorToDoList.Model
@using BlazorToDoList.Service
@inject NavigationManager NavigationManager
@inject UserState state

<div class="login-container">
    <h2>Login</h2>
    <EditForm FormName ="LoginForm" Model="loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="Username">Username:</label>
            <InputText id="username" @bind-Value="loginModel.Username" class="form-control" />
        </div>

        <div class="form-group">
            <label for="Password">Password:</label>
            <InputText id="password" @bind-Value="loginModel.Password" type="password" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary specialBtn">Login</button>
    </EditForm>

    @if (errorMessage != null)
    {
        <p class="error-message">@errorMessage</p>
    }

    <p>
        <a href="/register">Register</a>
    </p>
</div>
@* Login Style *@
<style>
    .login-container {
    width: 300px;
    margin: 100px auto;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 5px;
    }
    .form-group {
    margin-bottom: 15px;
    }
    .error-message {
    color: red;
    }
</style>

@code {
    //private LoginModel loginModel;
    private LoginModel loginModel;
    private string errorMessage;
    protected override void OnInitialized()
    {
        loginModel = new LoginModel();
    }

    private  void HandleLogin()
    {
        //  Authentication (replace with your actual logic)
        LoginService login = new LoginService();
        User user = login.GetUser(loginModel.Username, loginModel.Password);
        //var temp = state.UserId;
        if (user.UserId>0)
        {
            // Set user state
            state.SetUserState(user.UserId, user.UserName, false);
            // Redirect to home page
            // if (user.UserId != temp)
            //      StateHasChanged();
            NavigationManager.NavigateTo("/todolist");
        }
        else
        {
            errorMessage = "Invalid username or password.";
        }
    }
}
